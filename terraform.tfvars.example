# Replace with the subscription where you are authorized to create resources.
subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "Central India"
project_name    = "my-azure-project"

virtual_network_cidr = ["10.0.0.0/16"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]
enable_nat_gateway   = false

vm_size        = "Standard_B1s"
admin_username = "azureuser"

# Paste only your OpenSSH public key. Never place a private key here.
ssh_public_key = "ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY"

# Replace with your public IP followed by /32. Leave empty to disable SSH.
allowed_ssh_cidrs  = ["203.0.113.10/32"]
allowed_http_cidrs = ["0.0.0.0/0"]
os_disk_size_gb    = 30

image_publisher = "Canonical"
image_offer     = "0001-com-ubuntu-server-jammy"
image_sku       = "22_04-lts-gen2"
image_version   = "latest"

# Optional cloud-init example:
# custom_data = <<-CLOUD_INIT
#   #cloud-config
#   packages:
#     - nginx
#   runcmd:
#     - systemctl enable --now nginx
# CLOUD_INIT

common_tags = {
  Environment = "dev"
  ManagedBy   = "Terraform"
  Owner       = "your-name"
}

